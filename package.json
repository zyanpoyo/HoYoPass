{
  "name": "hoyopass",
  "version": "1.0.1",
  "description": "HoYoPass - 交換コード自動引き換えツール",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:dev": "node scripts/build.js dev",
    "build:prod": "node scripts/build.js prod",
    "watch:dev": "node scripts/build.js dev --watch",
    "check-secrets": "node scripts/check-secrets.js",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node scripts/generate-screenshots.js",
    "download-game-icons": "node scripts/download-game-icons.js",
    "process-genshin-icon": "powershell -ExecutionPolicy Bypass -File scripts/process-genshin-icon.ps1",
    "setup": "npm run generate-icons && npm run download-game-icons",
    "package": "node scripts/package.js"
  },
  "keywords": [
    "genshin",
    "starrail",
    "zzz",
    "hoyoverse",
    "chrome-extension"
  ],
  "author": "zyanpoyo",
  "license": "MIT"
}